# PostgreSQL
POSTGRES_DB=happytorch
POSTGRES_USER=happytorch
POSTGRES_PASSWORD=happytorch_dev

# Backend
DATABASE_URL=postgres://happytorch:happytorch_dev@postgres:5432/happytorch?sslmode=disable
JWT_SECRET=dev-secret-change-in-production
JUDGE_URL=http://judge:9000

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Review (optional)
# Set to "true" to auto-approve problems that pass AI review with score >= 80
AI_AUTO_APPROVE=false

# LLM Provider for enhanced AI review (optional)
# Options: gemini, qwen, claude, openai, none
LLM_PROVIDER=none
LLM_API_KEY=
# Optional: override default model (e.g., gemini-1.5-pro, qwen-plus, claude-3-sonnet, gpt-4o)
LLM_MODEL=

# Frontend
VITE_API_URL=http://localhost:8080
